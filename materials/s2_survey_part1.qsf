Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":20,"NextAnswerId":1}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"pn_timer","QuestionID":"QID44","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"ne_timer","QuestionID":"QID45","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":28,"NextAnswerId":1}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"disadv_lie_timer","QuestionID":"QID46","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":28,"NextAnswerId":1}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"explain_disadv_timer","QuestionID":"QID47","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Thank you for taking part in this study. Please click the button below to be redirected back to P...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for taking part in this study. Please click the button below to be redirected back to Prolific and register your submission.<br \/>\n<br \/>\nIf you receive a bonus payment larger than zero, you will receive it in a few days on Prolific after the study is finished.","DefaultChoices":false,"DataExportTag":"end","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for taking part in this study. Please click the button below to be redirected back to P...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID49"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"This is your first opportunity to earn a bonus.\u00a0You will complete the following task: You will be..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>This is your first opportunity to earn a bonus.&nbsp;<\/strong>You will complete the following task:<br \/>\n<br \/>\nYou will be asked to pick a whole number between 1 and 5 (that is, 1, 2, 3, 4, or 5) and keep it only in your mind. After that, you will go to a website. The website will show you a number from 1 to 5 that it selects randomly. All you need to do is indicate whether the number the website shows you is the same as the one you picked.<br \/>\n<br \/>\nIf you report that the number you kept in mind is the same as the number shown by the website, we call this <strong>reporting a match<\/strong>.","DefaultChoices":false,"DataExportTag":"mg_des_gen","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is your first opportunity to earn a bonus.\u00a0You will complete the following task: You will be...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID5"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Regarding the task you just completed: In your opinion (and independent of the opinion of other p...","TertiaryAttribute":null,"Payload":{"QuestionText":"Regarding the task you just completed:<br \/>\n<br \/>\nIn your opinion (and independent of the opinion of other people), in this task, <b>how appropriate is it to report a match without actually obtaining one?<\/b> Here, &ldquo;appropriate&rdquo; means what you <strong>personally<\/strong> consider to be &ldquo;correct&rdquo; or &ldquo;ethical.&rdquo;","DefaultChoices":false,"DataExportTag":"pn","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW","NumColumns":2},"QuestionDescription":"Regarding the task you just completed: In your opinion (and independent of the opinion of other p...","Choices":{"1":{"Display":"Very <strong>inappropriate<\/strong>"},"2":{"Display":"<strong>Inappropriate<\/strong>"},"3":{"Display":"Somewhat <strong>inappropriate<\/strong>"},"4":{"Display":"Somewhat <strong>appropriate<\/strong>"},"5":{"Display":"<strong>Appropriate<\/strong>"},"6":{"Display":"Very <strong>appropriate<\/strong>"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID6"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Regarding the task that you just completed: In this task, how socially appropriate is it to repor...","TertiaryAttribute":null,"Payload":{"QuestionText":"Regarding the task that you just completed:<br \/>\n<br \/>\nIn this task, <strong>how socially appropriate is it to report a match without actually obtaining one?<\/strong> Here, &ldquo;socially appropriate&rdquo; means what <strong>most people<\/strong> would agree is &ldquo;correct&rdquo; or &ldquo;ethical,&rdquo; independent of what you think yourself.<br \/>\n<br \/>\n<strong>This is your second opportunity to earn a bonus payment<\/strong>. You will receive a bonus of &pound;0.40 <strong>if your response is the most common response within the group of participants that complete the task alongside you<\/strong>. In other words, whichever response option you choose below, if more participants in your group choose this option than any other option, you will receive &pound;0.40 for this question. It is thus in your interest to <b>choose what you think most people would choose<\/b>.","DataExportTag":"ne","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Regarding the task that you just completed: In this task, how socially appropriate is it to repor...","Choices":{"1":{"Display":"Very socially <strong>inappropriate<\/strong>"},"2":{"Display":"Socially <strong>inappropriate<\/strong>"},"3":{"Display":"Somewhat socially <strong>inappropriate<\/strong>"},"4":{"Display":"Somewhat socially <strong>appropriate<\/strong>"},"5":{"Display":"Socially <strong>appropriate<\/strong>"},"6":{"Display":"Very socially <strong>appropriate<\/strong>"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID7"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Of 100 Prolific participants who did not obtain a match in the task you just completed, how many...","TertiaryAttribute":null,"Payload":{"QuestionText":"Of <b>100<\/b> Prolific participants who <b>did not obtain a match<\/b> in the task you just completed, how many do you believe will nevertheless report a match?<br><br>Please answer with a whole number between 0 and 100.","DefaultChoices":false,"DataExportTag":"ee","QuestionID":"QID8","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Of 100 Prolific participants who did not obtain a match in the task you just completed, how many...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"0","Max":"100","NumDecimals":"0"}}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"You did not report a match in the task that you just completed. But did you actually obtain a match?","TertiaryAttribute":null,"Payload":{"QuestionText":"You did not report a match in the task that you just completed.<br>\n<br>\nBut did you actually obtain a match?","DefaultChoices":false,"DataExportTag":"actual_match","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You did not report a match in the task that you just completed. But did you actually obtain a match?","Choices":{"1":{"Display":"Yes, I actually obtained a match. I chose not to report one."},"2":{"Display":"No, I did not obtain a match."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID9"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}