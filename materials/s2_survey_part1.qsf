ly after you have answere...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"var CORRECT_ANSWERS = {\n\t\"QID21\": \"1\",\n\t\"QID26\": \"1\",\n\t\"QID27\": \"1\",\n\t\"QID28\": \"1\",\n\t\"QID33\": \"2\",\n\t\"QID29\": \"2\",\n\t\"QID30\": \"2\"\n};\nvar NOT_YET_RECORDED = -1;\n\nQualtrics.SurveyEngine.addOnPageSubmit(function(submitType) {\n\tif (submitType !== \"next\") return;\n\t\n\tvar previousAttempts = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"CQ_attempts\"));\n\tQualtrics.SurveyEngine.setEmbeddedData(\"CQ_attempts\", previousAttempts + 1);\n\t\n\tvar recordedErrors = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"CQ_first_errors\"));\n\tif (recordedErrors !== NOT_YET_RECORDED) return;\n\t\n\tvar errorCount = 0, answeredCount = 0, displayedCount = 0;\n\tfor (var questionID in CORRECT_ANSWERS) {\n\t\tvar isDisplayed = jQuery(\"#\" + questionID).length > 0;\n\t\tif (!isDisplayed) continue;\n\t\tdisplayedCount++;\n\t\t\n\t\tvar selectedChoice = jQuery(\"#\" + questionID + \" input:checked\").val();\n\t\tif (selectedChoice === undefined) continue;\n\t\tansweredCount++;\n\t\t\n\t\tif (selectedChoice !== CORRECT_ANSWERS[questionID]) errorCount++;\t\t\n\t}\n\t\n\tvar attemptIsComplete = displayedCount > 0 && answeredCount === displayedCount;\n\tif (!attemptIsComplete) return;\n\t\n\tQualtrics.SurveyEngine.setEmbeddedData(\"CQ_first_errors\", errorCount);\n\tQualtrics.SurveyEngine.setEmbeddedData(\"CQ_items_shown\", displayedCount);\n});"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID37","SecondaryAttribute":"Please complete the verification below.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please complete the verification below.","DefaultChoices":false,"DataExportTag":"recaptcha","QuestionType":"Captcha","Selector":"V2","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Alig