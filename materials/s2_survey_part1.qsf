sageID":"VE_CUSTOM_VALIDATION_1"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID28","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> cp <\/span>","LeftOperand":"condition","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"cp","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"If more than 25% of the participants in my group report a match, only those who report a match wi...","TertiaryAttribute":null,"Payload":{"QuestionText":"If more than 25% of the participants in my group report a match, only those who report a match will lose \u00a30.20.","DataExportTag":"mg_c5","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If more than 25% of the participants in my group report a match, only those who report a match wi...","Choices":{"1":{"Display":"True"},"2":{"Display":"False"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID29\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">If more than 25% of the participants in my group report a match, only those who report a match wi...<\/span> <span class=\"LeftOpDesc\">False<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID29\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID29","QuestionIDFromLocator":"QID29","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Q5 Wrong","libraryID":"UR_3yGgWsCLxbqWiTH","messageID":"MS_Pz6vVvuZ47wmSK1","subMessageID":"VE_CUSTOM_VALIDATION_3"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID29","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> cp <\/span>","LeftOperand":"condition","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"cp","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Introduction Thank you for taking part in our study. During this study, you will have two opportu...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Introduction<\/strong><br \/>\n<br \/>\nThank you for taking part in our study.<br \/>\n<br \/>\nDuring this study, you will have <strong>two opportunities to earn a bonus payment<\/strong>. How much you earn depends on your responses. Therefore, please pay close attention to the instructions.<br \/>\n<br \/>\nAfter the study is completed, <strong>one of the two bonuses will be randomly chosen by the computer for payout<\/strong>. You will receive the bonus via Prolific a few days after the study is finished.<br \/>\n<br \/>\n<strong>Please note that you will be part of a group of around 1,000 participants completing this study alongside you.<\/strong><br \/>\n<br \/>\n<span style=\"color:#c0392b;\">We emphasise that all information we give you about this task and your payment is accurate.<\/span><br \/>\n<br \/>\nThis study does not require lengthy open-ended responses; however, there will be a few brief ones. Please do not use external sources or tools to assist with completing the survey unless you are instructed to do so. Your responses can be brief, and we appreciate genuine, personal experiences and thoughts.","DefaultChoices":false,"DataExportTag":"intro","QuestionID":"QID3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Introduction Thank you for taking part in our study. During this study, you will have two opportu...","Choices":{"1":{"Display":"I have read and understood the above. I am ready to proceed."}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"If I do not report a match, I will receive a larger bonus for this task than if I report one.","TertiaryAttribute":null,"Payload":{"QuestionText":"If I do not report a match, I will receive a larger bonus for this task than if I report one.","DataExportTag":"mg_c6","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"If I do not report a match, I will receive a larger bonus for this task than if I report one.","Choices":{"1":{"Display":"True"},"2":{"Display":"False"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID30\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">If I do not report a match, I will receive a larger bonus for this task than if I report one.<\/span> <span class=\"LeftOpDesc\">False<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID30\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID30","QuestionIDFromLocator":"QID30","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Q6 Wrong","libraryID":"UR_3yGgWsCLxbqWiTH","messageID":"MS_Pz6vVvuZ47wmSK1","subMessageID":"VE_CUSTOM_VALIDATION_4"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID30","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> baseline <\/span>","LeftOperand":"condition","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"baseline","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"The task now starts. Please select a number between 1 and 5 (that is, 1, 2, 3, 4, or 5), and keep...","TertiaryAttribute":null,"Payload":{"QuestionText":"The task now starts.<br><br><b>Please select a number between 1 and 5<\/b> (that is, 1, 2, 3, 4, or 5), and keep it in mind.<br>\n<br>\nDo you have a number in your mind now? Please make sure that you remember it as you proceed to the next page.","DefaultChoices":false,"DataExportTag":"mg_number","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The task now starts. Please select a number between 1 and 5 (that is, 1, 2, 3, 4, or 5), and keep...","Choices":{"1":{"Display":"Yes, I have picked a number from 1\u20135."}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"Please visit the website linked below. It is a website widely used to generate random numbers. Th...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please visit the website linked below. It is a website widely used to generate random numbers.<br \/>\n<br \/>\nThe website may already show you a randomly generated number when it loads. Regardless of whether there is already a number, please <strong>click &ldquo;Go&rdquo; (at the bottom centre of the page) once and only once<\/strong> to generate a new number.<br \/>\n<br \/>\n<a href=\"https:\/\/numbergenerator.org\/randomnumbergenerator\/1-5\" target=\"_blank\">https:\/\/numbergenerator.org\/randomnumbergenerator\/1-5<\/a><br \/>\n<br \/>\nIs the generated number the same as what you have in mind? If yes, you have obtained a match.","DataExportTag":"match","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please visit the website linked below. It is a website widely used to generate random numbers. Th...","Choices":{"1":{"Display":"Yes, I obtained a match."},"2":{"Display":"No, I did not obtain a match."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID32"}},{"SurveyID":"SV_893RCDpKw0JqGk6","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"My bonus payment will be negatively affected if too many other participants report a match, regar...","TertiaryAttribute":null,"Payload":{"QuestionText":"My bonus payment will be negatively affected if too many other participants report a match, regardless of whether I report a match or not.","DataExportTag":"mg_c4f","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"My bonus payment will be negatively affected if too many other participants report a match, regar...","Choices":{"1":{"Display":"True"},"2":{"Display":"False"}},"